# Server & Runtime Configuration
PORT="3000"
HOST="0.0.0.0"
NODE_ENV="development"
PYTHON_EXEC="/usr/bin/python3"

# Storage Driver Architecture (Active default: 'json')
# Allowed values: 'json' (default local file-backed), 'postgres' (PostgreSQL database)
STORAGE_DRIVER="json"

# Staging Database URL (Disposable, isolated PostgreSQL 15+ database for staging verification)
# Example: postgresql://postgres:password@staging-db.cit.internal:5432/cit_staging?sslmode=require
STAGING_DATABASE_URL=""

# Production Database URL (Used only when STORAGE_DRIVER=postgres in production)
# Example: postgresql://postgres:password@prod-db.cit.internal:5432/cit_campus?sslmode=require
DATABASE_URL=""

# Solver Microservice Configuration (For containerized Python solver deployment)
SOLVER_SERVICE_URL=""
SOLVER_API_SECRET=""

# AI Studio injected environment variables
GEMINI_API_KEY=""
APP_URL=""
